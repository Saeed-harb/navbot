<launch>
    <let name="urdf_path" 
         value="$(find-pkg-share navbot_description)/urdf/navbot.urdf.xacro" />
    <let name="rviz_config_path"
         value="$(find-pkg-share navbot_description)/rviz/urdf_config.rviz" />
    <let name="ekf_config_path"
         value="$(find-pkg-share navbot_bringup)/config/ekf.yaml" />

    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description"
               value="$(command 'xacro $(var urdf_path)')" />
    </node>

    <node pkg="controller_manager" exec="ros2_control_node">
        <param from="$(find-pkg-share navbot_bringup)/config/navbot_controllers.yaml" />
    </node>

    <node pkg="controller_manager" exec="spawner" args="joint_state_broadcaster" />

    <node pkg="controller_manager" exec="spawner" args="diff_drive_controller" />

    <node pkg="navbot_py_pkg" exec="twist_stamper" />

    <node pkg="navbot_py_pkg" exec="imu_publisher" />

    <!-- <node pkg="robot_localization" exec="ekf_node" name="ekf_odom">
        <param name="ekf_config_file"
               value="$(var ekf_config_path)" />
    </node> -->

    <!-- <node pkg="robot_localization" type="ekf_localization_node" name="ekf_se" clear_params="true">
          <rosparam command="load" file="$(var ekf_config_path)" />
    </node> -->

    <node pkg="rviz2" exec="rviz2" output="screen" 
          args="-d $(var rviz_config_path)" />
</launch>
