<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="base_length" value="0.231" />
    <xacro:property name="base_width" value="0.131" />
    <xacro:property name="base_height" value="0.054" />
    <xacro:property name="wheel_radius" value="0.043" />
    <xacro:property name="wheel_length" value="0.037" />
    <xacro:property name="caster_wheel_radius" value="0.0305" />

    <link name="base_footprint" />

    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>01
            <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0" />
            <material name="blue" />
        </visual>
        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0" />
        </collision>
        <xacro:box_inertia m="5.0" x="${base_length}" y="${base_width}" z="${base_height}" 
                           o_xyz="0 0 ${base_height / 2.0}" o_rpy="0 0 0" />
    </link>

    <xacro:macro name="wheel_link" params="prefix">
        <link name="${prefix}_wheel_link">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}" />
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
                <material name="grey" />
            </visual>
            <collision>
                <geometry>
                    <sphere radius="${wheel_radius}" />
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
            </collision>
            <xacro:cylinder_inertia m="0.5" r="${wheel_radius}" l="${wheel_length}" 
                           o_xyz="0 0 0" o_rpy="${pi / 2.0} 0 0" />
        </link>
    </xacro:macro>

    <xacro:wheel_link prefix="right" />
    <xacro:wheel_link prefix="left" />

    <link name="caster_wheel_link">
        <visual>
            <geometry>
                <sphere radius="${caster_wheel_radius}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <sphere radius="${caster_wheel_radius}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <xacro:sphere_inertia m="0.5" r="${caster_wheel_radius}" 
                           o_xyz="0 0 0" o_rpy="0 0 0" />
    </link>

    <link name="camera_link"/>

    <xacro:macro name="cylinder_link" params="prefix">
        <link name="${prefix}_cylinder_link">
            <visual>
                <geometry>
                    <cylinder radius="0.005" length="0.02" />
                </geometry>
                <origin xyz="0 0 0.01" rpy="0 0 0" />
                <material name="grey" />
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="0.005" length="0.02" />
                </geometry>
                <origin xyz="0 0 0.01" rpy="0 0 0" />
            </collision>
            <xacro:cylinder_inertia m="0.1" r="0.005" l="0.02" 
                           o_xyz="0 0 0.01" o_rpy="0 0 0" />
        </link>
    </xacro:macro>

    <xacro:cylinder_link prefix="r1" />
    <xacro:cylinder_link prefix="l1" />
    <xacro:cylinder_link prefix="r2" />
    <xacro:cylinder_link prefix="l2" />

    <link name="holder_link">
        <visual>
            <geometry>
                <box size="0.077 0.077 0.002" />
            </geometry>
            <origin xyz="0 0 0.001" rpy="0 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <box size="0.077 0.077 0.002" />
            </geometry>
            <origin xyz="0 0 0.001" rpy="0 0 0" />
        </collision>
        <xacro:box_inertia m="0.2" x="0.077" y="0.077" z="0.002" 
                           o_xyz="0 0 0.001" o_rpy="0 0 0" />
    </link>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 0.055" rpy="0 0 0"/>
    </joint>

    <joint name="base_right_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="right_wheel_link" />
        <origin xyz="-0.072 -0.09 -0.018" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="base_left_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="left_wheel_link" />
        <origin xyz="-0.072 0.09 -0.018" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="base_caster_wheel_joint" type="fixed">
        <parent link="base_link" />
        <child link="caster_wheel_link" />
        <origin xyz="0.0775 0 -0.0275" rpy="0 0 0" />
    </joint>

    <joint name="base_camera_joint" type="fixed">
        <parent link="base_link" />
        <child link="camera_link" />
        <origin xyz="${base_length / 2.0} 0 ${base_height}" rpy="0 -0.5 0" />
    </joint>

    <joint name="base_l1_cylinder_joint" type="fixed">
        <parent link="base_link" />
        <child link="l1_cylinder_link" />
        <origin xyz="0.025 0.025 ${base_height}" rpy="0 0 0" />
    </joint>

    <joint name="base_r1_cylinder_joint" type="fixed">
        <parent link="base_link" />
        <child link="r1_cylinder_link" />
        <origin xyz="0.025 -0.025 ${base_height}" rpy="0 0 0" />
    </joint>

    <joint name="base_l2_cylinder_joint" type="fixed">
        <parent link="base_link" />
        <child link="l2_cylinder_link" />
        <origin xyz="-0.025 0.025 ${base_height}" rpy="0 0 0" />
    </joint>

    <joint name="base_r2_cylinder_joint" type="fixed">
        <parent link="base_link" />
        <child link="r2_cylinder_link" />
        <origin xyz="-0.025 -0.025 ${base_height}" rpy="0 0 0" />
    </joint>

    <joint name="base_holder_joint" type="fixed">
        <parent link="base_link" />
        <child link="holder_link" />
        <origin xyz="0 0 ${base_height + 0.020}" rpy="0 0 0" />
    </joint>

    <gazebo reference="caster_wheel_link">
        <mu1 value="0.1" />
        <mu2 value="0.1" />
    </gazebo>

</robot>
